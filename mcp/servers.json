{
  "github": {
    "type": "remote",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": { "Authorization": "Bearer ${GITHUB_MCP_TOKEN}" }
  },
  "playwright": {
    "type": "local",
    "command": ["npx", "@playwright/mcp@0.0.85"]
  },
  "open-computer-use": {
    "type": "local",
    "command": ["${HOME}/.local/bin/ocu"]
  }
}
